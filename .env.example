# Admin password (required)
ADMIN_PASSWORD=your-secure-password-here

# Vercel KV / Upstash Redis (for production CMS persistence)
# Get these from Vercel Dashboard → Storage → Redis (Upstash)
# If not set, content is saved to data/site-content.json locally
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: KV URL format (alternative env var names from Upstash integration)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Supabase Storage & Postgres CMS Database (Alternative to Vercel KV / Blob)
# Get these from Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
